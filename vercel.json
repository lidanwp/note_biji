{
  "rewrites": [
    {
      "source": "/tools/timeletter",
      "destination": "/tools/timeletter.html"
    },
    {
      "source": "/((?!api/|tools/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/notes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=30, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/comments",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/user-progress",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=10, s-maxage=10, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
