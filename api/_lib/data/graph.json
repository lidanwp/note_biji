    { "id": "scope_management", "title": "项目范围管理", "phase": "规划", "chapterOrder": 5 },
    { "id": "schedule_management", "title": "项目进度管理", "phase": "规划", "chapterOrder": 6 },
    { "id": "cost_management", "title": "项目成本管理", "phase": "规划", "chapterOrder": 7 },
    { "id": "quality_management", "title": "项目质量管理", "phase": "规划", "chapterOrder": 8 },
    { "id": "resource_management", "title": "项目资源管理", "phase": "执行", "chapterOrder": 9 },
