    },
    {
      "from": "procurement_management",
      "to": "procurement_management",
      "relation": "contrasts_with",
      "output": "合同类型",
      "description": "对比类知识：总价合同 vs 成本补偿合同 vs 工料合同 的风险分担"
    }
